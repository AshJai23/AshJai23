{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SmartInvest: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "smartinvest.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--no-access-log"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "SmartInvest: install project"
    }
  ]
}
